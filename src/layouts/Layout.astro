---
import "../styles/theme.scss";
import "../styles/global.css";
import "../styles/custom.scss";

const pathname: string = Astro.url.pathname;
console.log(pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Astro Basics</title>
	</head>

	<body class="darkground flex w-full h-screen">
		<main class="w-full h-full flex">
			<!-- Sidebar -->
			<aside
				class="sidebar min-w-[240px] h-full flex flex-col justify-between pd-border px-4 py-6"
			>
				<!-- Top: Logo / Brand -->
				<div class="space-y-8">
					<div class="text-white text-xl font-bold px-2">ACME</div>

					<!-- Navigation -->
					<nav class="flex flex-col text-sm gap-2">
						{
							[
								{
									l: "Dashboard",
									p: "/",
								},
								{
									l: "Applications",
									p: "/applications",
								},
								{
									l: "Terminal",
									p: "/terminal",
								},
							].map((a) => {
								return (
									<a
										href={a.p}
										class={`sidebar-link ${pathname === a.p ? "active" : undefined}`}
									>
										{a.l}
									</a>
								);
							})
						}
					</nav>
				</div>

				<!-- Bottom: Account or Logout -->
				<div>
					<a
						class="text-sm sidebar-link text-red-400 hover:bg-[hsl(var(--color-text-danger))]"
					>
						Logout
					</a>
				</div>
			</aside>

			<!-- Main Content -->
			<section class="panel flex-grow h-full">
				<slot />
			</section>
		</main>
	</body>
</html>

<style lang="scss" scoped>
	.darkground {
		background-color: hsl(var(--color-neutral-105));
	}

	.panel {
		background-color: hsl(var(--color-neutral-100));
	}

	.pd-border {
		border-right: 1px solid hsl(var(--color-neutral-85));
	}

	.sidebar-link {
		@apply block w-full px-4 py-2 rounded-lg text-gray-100 transition-colors duration-150;

		background-color: hsl(var(--color-neutral-90));

		&:hover {
			background-color: hsl(var(--color-neutral-85));
		}

		&.active {
			background-color: hsl(var(--color-neutral-85));
			font-weight: 600;
		}
	}
</style>
