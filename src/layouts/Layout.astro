---
import "../styles/theme.scss";
import "../styles/global.css";
import "../styles/custom.scss";

const pathname: string = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Astro Basics</title>
	</head>

	<body class="darkground flex flex-wrap w-full h-screen overflow-hidden">
		<nav
			class="bg-[hsl(var(--color-neutral-105))] py-2 h-[3.5rem] w-full border-b border-neutral-85"
		>
			<!--  -->
		</nav>

		<main class="w-full h-[calc(100vh-3.5rem)] flex overflow-hidden">
			<!-- Sidebar -->
			<aside
				class="sidebar min-w-[240px] h-full flex flex-col justify-between pd-border px-4 pt-6 pb-2"
			>
				<!-- Top: Logo / Brand -->
				<div class="space-y-8">
					<!-- <div class="text-white text-xl font-bold px-2">ACME</div> -->

					<!-- Navigation -->
					<nav class="flex flex-col text-sm gap-2">
						{
							[
								{ l: "Dashboard", p: "/" },
								{ l: "Applications", p: "/applications" },
								{ l: "File Manager", p: "/file-manager" },
								{ l: "Terminal", p: "/terminal" },
								{ l: "Users", p: "/users" },
							].map((a) => {
								return (
									<a
										href={a.p}
										class={`sidebar-link ${pathname == a.p ? "active" : undefined}`}
									>
										{a.l}
									</a>
								);
							})
						}
					</nav>
				</div>

				<!-- Bottom: Account or Logout -->
				<div class="mt-auto pt-2 mb-2">
					<button
						class="text-sm sidebar-link text-red-400 hover:bg-[hsl(var(--color-text-danger))]"
					>
						Logout
					</button>
				</div>
			</aside>

			<!-- Main Content -->
			<section class="panel flex-grow h-full overflow-y-auto">
				<!-- Watermark (optional) -->
				<!-- <section
					class="text-center w-full bg-[hsl(var(--color-primary-300))] text-[hsl(var(--color-neutral-0))] py-1"
				>
					<p class="text-sm">
						<strong>BETA</strong>
						<span> </span>
						<span
							>open-source at <strong>
								<a
									target="_blank"
									href="https://github.com/jub0t/mechon"
									>github.com/jub0t/mechon</a
								></strong
							></span
						>
					</p>
				</section> -->

				<slot />
			</section>
		</main>
	</body>
</html>

<style lang="scss" scoped>
	.darkground {
		background-color: hsl(var(--color-neutral-105));
	}

	.panel {
		background-color: hsl(var(--color-neutral-100));
	}

	.pd-border {
		border-right: 1px solid hsl(var(--color-neutral-85));
	}

	.sidebar-link {
		@apply block w-full px-4 py-2 rounded-lg text-gray-100 transition-colors duration-150;

		background-color: hsl(var(--color-neutral-90));

		&:hover {
			background-color: hsl(var(--color-neutral-85));
		}

		&.active {
			background-color: hsl(var(--color-neutral-85));
			font-weight: 600;
		}
	}
</style>
